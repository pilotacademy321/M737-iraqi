{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and account status in M737 Medical Platform",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication UID matching document ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Primary verified email address",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Full name or professional title of the user",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Platform role assigned to the user",
          "enum": ["doctor", "radiology_center", "laboratory", "pharmacy", "patient", "super_admin", "secretary"]
        },
        "status": {
          "type": "string",
          "description": "Account accreditation and approval state",
          "enum": ["incomplete", "pending", "approved", "rejected", "suspended"]
        },
        "licenseNumber": {
          "type": "string",
          "description": "Iraqi medical syndicate or operational license number",
          "maxLength": 64
        },
        "facilityName": {
          "type": "string",
          "description": "Associated clinic, lab, radiology center, or pharmacy name",
          "maxLength": 128
        },
        "governorate": {
          "type": "string",
          "description": "Iraqi governorate where provider operates",
          "maxLength": 64
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone or WhatsApp number",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile modification"
        }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Verified platform administrator record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of administrator",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Email address of the administrator",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Administrative authority designation",
          "enum": ["super_admin"]
        },
        "grantedAt": {
          "type": "string",
          "description": "Timestamp when admin access was initialized"
        }
      },
      "required": ["uid", "email", "role", "grantedAt"]
    },
    "DoctorProfile": {
      "title": "DoctorProfile",
      "description": "Detailed clinical practice profile, schedule, and fees for accredited doctors",
      "type": "object",
      "properties": {
        "doctorId": {
          "type": "string",
          "description": "UID of the doctor",
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "description": "Doctor full legal/professional title",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL"
        },
        "specialty": {
          "type": "string",
          "description": "Primary medical specialty",
          "maxLength": 128
        },
        "subspecialty": {
          "type": "string",
          "description": "Subspecialty or focused discipline",
          "maxLength": 128
        },
        "qualifications": {
          "type": "string",
          "description": "Degrees, fellowships and board certifications",
          "maxLength": 256
        },
        "experienceYears": {
          "type": "number",
          "description": "Years of clinical practice experience"
        },
        "clinicAddress": {
          "type": "string",
          "description": "Clinic street address, building and floor",
          "maxLength": 256
        },
        "governorate": {
          "type": "string",
          "description": "Iraqi governorate of the clinic",
          "maxLength": 64
        },
        "phone": {
          "type": "string",
          "description": "Clinic telephone or contact number",
          "maxLength": 32
        },
        "whatsapp": {
          "type": "string",
          "description": "Direct WhatsApp line for clinic queries",
          "maxLength": 32
        },
        "consultationFee": {
          "type": "number",
          "description": "Standard consultation fee in Iraqi Dinars (IQD)"
        },
        "workingDays": {
          "type": "array",
          "description": "Active clinical days of the week"
        },
        "workingHours": {
          "type": "string",
          "description": "Clinical working hours window",
          "maxLength": 64
        },
        "mapsUrl": {
          "type": "string",
          "description": "Google Maps link to the clinic location"
        },
        "bio": {
          "type": "string",
          "description": "Brief professional overview for patients",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["doctorId", "fullName", "specialty", "clinicAddress", "governorate", "consultationFee", "workingHours", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinical consultation appointment between doctor and patient",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique appointment identifier"
        },
        "doctorId": {
          "type": "string",
          "description": "UID of the doctor",
          "maxLength": 128
        },
        "patientId": {
          "type": "string",
          "description": "UID of the patient",
          "maxLength": 128
        },
        "patientName": {
          "type": "string",
          "description": "Full name of the patient",
          "maxLength": 128
        },
        "patientPhone": {
          "type": "string",
          "description": "Phone number of patient",
          "maxLength": 32
        },
        "doctorName": {
          "type": "string",
          "description": "Doctor name at booking",
          "maxLength": 128
        },
        "specialty": {
          "type": "string",
          "description": "Specialty under which visit is booked",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "description": "Appointment date YYYY-MM-DD"
        },
        "timeSlot": {
          "type": "string",
          "description": "Time slot string e.g. 17:30"
        },
        "status": {
          "type": "string",
          "description": "Status of the appointment",
          "enum": ["pending", "confirmed", "rescheduled", "completed", "cancelled"]
        },
        "rescheduleReason": {
          "type": "string",
          "description": "Doctor reason for rescheduling"
        },
        "rescheduleProposedDate": {
          "type": "string",
          "description": "Proposed new date and time"
        },
        "consultationType": {
          "type": "string",
          "description": "Type of consultation",
          "enum": ["in_person", "followup", "urgent"]
        },
        "notes": {
          "type": "string",
          "description": "Clinical or appointment notes",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["doctorId", "patientName", "date", "timeSlot", "status", "createdAt", "updatedAt"]
    },
